{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "build:prod": "node ./build.mjs",
    "start": "NODE_ENV=production node --enable-source-maps ./dist/index.mjs",
    "start:prod": "NODE_ENV=production node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
