# --- API server (@workspace/api-server) ---
# Required locally. Render provides PORT in production; do not create a
# Render env var for it unless you intentionally need to override the platform.
PORT=3001
# Use `production` in deployed API (JSON logs). Use `development` locally for readable logs.
NODE_ENV=development
# Optional: pino log level (default info)
# LOG_LEVEL=info

# Required. (The older names AI_INTEGRATIONS_ANTHROPIC_API_KEY / _BASE_URL are still read.)
ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional API limits (defaults shown).
# Browser origins allowed to call the API, comma-separated. In Render, set this
# to the deployed frontend origin, for example:
# CORS_ORIGINS=https://conflict-analysis-vantage.vercel.app
# CORS_ORIGINS=https://conflict-analysis-vantage.vercel.app,http://localhost:5173
# Requests per client per window.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MINUTES=10
# New briefs generating at once, and new briefs per UTC day.
# BRIEF_MAX_CONCURRENT=4
# BRIEF_DAILY_BUDGET=300
# BRIEF_CACHE_TTL_MINUTES=360
# BRIEF_CACHE_MAX_ENTRIES=200
# BRIEF_MODEL=claude-haiku-4-5-20251001
# The second model that checks each claim against its quotes. "off" skips the check;
# claims are then served as unverified.
# BRIEF_VERIFY=on
# BRIEF_VERIFIER_MODEL=claude-haiku-4-5-20251001
# Map coordinates are looked up by place name (OpenStreetMap Nominatim by default).
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=Vantage/1.0 (+https://your-site.example)
# GEOCODER_MIN_GAP_MS=1100

# Optional. A Postgres connection string (for example from Neon). When set,
# briefs are saved there and their /brief/<id> links survive restarts and
# deploys; the table is created on first use. When unset, briefs are kept in
# memory and links last until the next restart.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# With a database, saved briefs, the rate limit, the daily budget and the cost
# ledger are shared by every instance and survive restarts. Turn this on once
# DATABASE_URL is set, so the server refuses to start without it:
# REQUIRE_DATABASE=true

# Operations. A long random string; GET /api/ops/costs answers only to
# "Authorization: Bearer <this>" and does not exist when it is unset.
# OPS_TOKEN=
# US dollars per million tokens for any model besides the default, as JSON:
# MODEL_PRICES={"claude-sonnet-5-5":{"input":3,"output":15}}

# --- Vantage frontend (build-time; Vite) ---
# When the UI is hosted on a different origin than the API, set this before
# `pnpm --filter @workspace/vantage run build` (no trailing slash). For the
# current Render API, use:
# VITE_API_BASE_URL=https://conflict-analysis.onrender.com
# Leave unset for same-origin / reverse-proxied /api (e.g. local dev with Vite proxy).
# VITE_API_BASE_URL=https://api.example.com

# --- Reading articles and evaluation ---
# Read the article behind each selected headline (robots.txt is honoured). "off"
# leaves every source on the publisher's summary.
# FULL_TEXT=on
# A separate key, with its own spending limit, for `pnpm eval`. Never the live site's key.
# EVAL_ANTHROPIC_API_KEY=
